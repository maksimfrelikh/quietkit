{
  "name": "quietkit",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "quietkit \u2014 developer tools that run in your browser.",
  "scripts": {
    "dev": "astro dev --port 4330",
    "build": "astro check && astro build",
    "build:nocheck": "astro build",
    "preview": "astro preview --port 4330",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "csp": "node scripts/check-csp.mjs",
    "verify": "npm run check && npm run lint && npm run test && npm run build:nocheck && npm run csp",
    "e2e": "scripts/e2e.sh",
    "e2e:update": "scripts/e2e.sh --update-snapshots"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.1",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.2",
    "stark-ui-kit": "github:maksimfrelikh/stark-ui-kit#v0.3.3",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "github:maksimfrelikh/stark-ui-kit#ca9d14d03a67706c76f8091ec767fa2e768d44a9": true
  }
}
